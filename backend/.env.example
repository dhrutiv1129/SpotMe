# Default local development uses a separate H2 database; no credentials are required.
# To use an isolated hosted PostgreSQL beta database, uncomment and fill these locally:
# SPRING_PROFILES_ACTIVE=postgres
# DATABASE_URL=jdbc:postgresql://YOUR_BETA_HOST:5432/postgres?sslmode=require
# DATABASE_USERNAME=YOUR_BETA_DATABASE_USER
# SUPABASE_DB_PASSWORD=
# ALLOWED_ORIGINS=https://YOUR_BETA_WEB_HOST
# SERVER_ADDRESS=0.0.0.0
